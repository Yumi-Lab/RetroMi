# shellcheck enable=require-variable-braces
# Source error handling, leave this in place
set -Ee

# Source CustomPIOS common.sh
# shellcheck disable=SC1091
source /common.sh
install_cleanup_trap


echo_green "install filebroswer..."
curl -fsSL --retry 5 --retry-delay 10 --retry-on-http-error 502,503,504 \
    "https://github.com/filebrowser/filebrowser/releases/latest/download/linux-armv7-filebrowser.tar.gz" \
    -o /tmp/filebrowser.tar.gz
tar -xzf /tmp/filebrowser.tar.gz -C /usr/local/bin filebrowser
rm -f /tmp/filebrowser.tar.gz
chmod +x /usr/local/bin/filebrowser

# Allow filebrowser to bind port 80 without root
setcap 'cap_net_bind_service=+ep' /usr/local/bin/filebrowser

echo "configure filebrowser (noauth, user=pi)"
cat << 'EOF' | sudo tee /usr/local/bin/start_filebrowser.sh
#!/bin/bash
# Remove stale DB so --noauth quick setup works (v2.62+)
rm -f /home/pi/.filebrowser.db
filebrowser --noauth --address 0.0.0.0 --port 80 --root /home/pi/RetroPie -d /home/pi/.filebrowser.db
EOF

sudo chmod +x /usr/local/bin/start_filebrowser.sh

cat << 'EOF' | sudo tee /etc/systemd/system/filebrowser.service
[Unit]
Description=FileBrowser Service
After=network.target

[Service]
ExecStart=/usr/local/bin/start_filebrowser.sh
Restart=always
User=pi
Group=pi

[Install]
WantedBy=multi-user.target
EOF

sudo systemctl daemon-reload
sudo systemctl enable filebrowser.service
echo_green "install filebroswer...(DONE)"
