#!/usr/bin/env bash
# Shebang for better file detection
#### firstboot actions
####
#### Written by Stephan Wendel aka KwadFan <me@stephanwe.de>
#### Copyright 2024
####
#### This File is distributed under GPLv3
####

set -e

# Debug ...
# set -x

DIALOGRC=/.firstboot
export DIALOGRC
DIALOG="$(which dialog)"
DIALOG=("${DIALOG}" --backtitle "YumiOS for RetroMi" --no-shadow --no-collapse)
BASE_USER="${BASE_USER:-pi}"

#change active tty
chvt 2
sleep 2

# Read actual terminal dimensions and fill the screen
TERM_ROWS=$(stty size < /dev/tty2 2>/dev/null | cut -d' ' -f1 || true)
TERM_COLS=$(stty size < /dev/tty2 2>/dev/null | cut -d' ' -f2 || true)
if [ -z "${TERM_ROWS}" ] || [ "${TERM_ROWS}" -lt 10 ] 2>/dev/null; then TERM_ROWS=30; fi
if [ -z "${TERM_COLS}" ] || [ "${TERM_COLS}" -lt 40 ] 2>/dev/null; then TERM_COLS=80; fi
RESOLUTION=($((TERM_ROWS)) $((TERM_COLS)))



# Center text vertically and horizontally inside dialog box
# $1 = text content, $2 = box height, $3 = text line count
center_text() {
    local text="$1" box_h="$2" text_lines="$3"
    local box_w="${RESOLUTION[1]}"
    # Vertical padding
    local vpad=$(( (box_h - text_lines - 6) / 2 ))
    if [ "${vpad}" -lt 0 ]; then vpad=0; fi
    local vpadding=""
    for ((i=0; i<vpad; i++)); do vpadding="${vpadding}\n"; done
    # Horizontal centering: pad each line
    local centered=""
    while IFS= read -r line; do
        local stripped
        stripped=$(echo "${line}" | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')
        local len=${#stripped}
        local hpad=$(( (box_w - len - 4) / 2 ))
        if [ "${hpad}" -lt 0 ]; then hpad=0; fi
        local spaces=""
        for ((j=0; j<hpad; j++)); do spaces="${spaces} "; done
        centered="${centered}${spaces}${stripped}\n"
    done <<< "${text}"
    printf '%b%b' "${vpadding}" "${centered}"
}

welcome_msg() {
    local msg
    msg=$(cat << 'MSGEOF'
Hello dear YUMI RetroMi One user,

Please be patient, we have to prepare your first start
of your RetroBox!

*** DO NOT UNPLUG DEVICE OR DISRUPT THIS PROCESS! ***
*** THIS WILL HARM YOUR OS! ***

Some steps may take several minutes. Stay patient.
The device will reboot after exiting ...

Continuing setup in ...
MSGEOF
)
    center_text "${msg}" "${RESOLUTION[0]}" 11
}

reboot_msg() {
    local msg
    msg=$(cat << 'MSGEOF'
Your device will be restarted in 5 seconds...

Thank you for being patient and have fun with your new

*** YUMI RetroMi ***
MSGEOF
)
    center_text "${msg}" "${RESOLUTION[0]}" 5
}

gen_initramfs() {
    update-initramfs -u &>/dev/null
}


disable_firstboot() {
    systemctl --quiet disable firstboot.service &>/dev/null
    rm -f /etc/systemd/system/firstboot.service &>/dev/null
}

# Welcome msg
"${DIALOG[@]}" --clear --title "Firstboot preperation" \
    --no-cancel --no-ok --pause "$(welcome_msg)" "${RESOLUTION[@]}" 15

# Init gauge
sleep 1 | "${DIALOG[@]}" --clear --gauge "Firstboot preperation ..." "${RESOLUTION[@]}" 0
if [[ -f /boot/armbianEnv.txt ]]; then
    sed -i 's/bootlogo=false/bootlogo=true/' /boot/armbianEnv.txt |
    "${DIALOG[@]}" --clear --gauge "Firstboot preperation ..." "${RESOLUTION[@]}" 10
fi

#Disable emulastation
script="/opt/retropie/configs/all/autostart.sh"
sed -i '/#auto/d' "$script"

# Update initramfs with smooth progress (runs in background)
INITRAMFS_START=$(date +%s)
gen_initramfs &
INITRAMFS_PID=$!
(
    pct=20
    while kill -0 "${INITRAMFS_PID}" 2>/dev/null; do
        echo "${pct}"
        if [ "${pct}" -lt 85 ]; then pct=$((pct + 1)); fi
        sleep 1
    done
    echo 90
) | "${DIALOG[@]}" --clear --gauge "Updating boot image (Plymouth splash)..." "${RESOLUTION[@]}" 20
wait "${INITRAMFS_PID}" 2>/dev/null || true
INITRAMFS_END=$(date +%s)
echo "firstboot: update-initramfs took $((INITRAMFS_END - INITRAMFS_START))s" >> /var/log/retromi-firstboot.log

# disable firstboot service
disable_firstboot
sleep 1 | "${DIALOG[@]}" --clear --gauge "Finalizing setup ..." "${RESOLUTION[@]}" 95

# Show fake finish
sleep 2 | "${DIALOG[@]}" --clear --gauge "Done! Preparing reboot ..." "${RESOLUTION[@]}" 100


#Enable Emulastation
sed -i '$a\' "$script"
echo "emulationstation #auto" >>"$script"
chown "${BASE_USER}":"${BASE_USER}" "$script"

# Force epicnoir theme — ES regenerates es_settings.cfg on first launch with Carbon default
# Fix both locations + add one-shot enforcer in autostart.sh
for cfg in /opt/retropie/configs/all/emulationstation/es_settings.cfg /home/"${BASE_USER}"/.emulationstation/es_settings.cfg; do
    if [ -f "${cfg}" ]; then
        sed -i 's|<string name="ThemeSet" value="[^"]*"|<string name="ThemeSet" value="epicnoir"|' "${cfg}"
    fi
done
# Add one-shot enforcer: runs once before ES, then removes itself
sed -i '/emulationstation #auto/i\
if [ ! -f /home/'"${BASE_USER}"'/.emulationstation/.epicnoir_set ]; then\
    sed -i '\''s|<string name="ThemeSet" value="[^"]*"|<string name="ThemeSet" value="epicnoir"|'\'' /home/'"${BASE_USER}"'/.emulationstation/es_settings.cfg 2>/dev/null\
    sed -i '\''s|<string name="ThemeSet" value="[^"]*"|<string name="ThemeSet" value="epicnoir"|'\'' /opt/retropie/configs/all/emulationstation/es_settings.cfg 2>/dev/null\
    touch /home/'"${BASE_USER}"'/.emulationstation/.epicnoir_set\
fi' "$script"

# Force menu_swap so Cross(btn2)=confirm in joy2key/RA menu
# Boot resets retroarch.cfg to defaults — this must run AFTER all configure steps
sed -i 's/menu_swap_ok_cancel_buttons = "false"/menu_swap_ok_cancel_buttons = "true"/' /opt/retropie/configs/all/retroarch.cfg 2>/dev/null

# Default to Dev Mode OFF (clean black screen between ES and games)
sed -i 's/disable_menu = "0"/disable_menu = "1"/' /opt/retropie/configs/all/runcommand.cfg 2>/dev/null

# Show reboot screen
"${DIALOG[@]}" --clear --title "Firstboot preperation" \
    --no-cancel --no-ok --pause "$(reboot_msg)" "${RESOLUTION[@]}" 5

# Cleanup
rm -f /.firstboot

# reboot
reboot

exit 0
