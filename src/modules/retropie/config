#!/usr/bin/env bash
# shellcheck enable=require-variable-braces
# shellcheck disable=SC2034

# RetroPie-Setup fork (used for post-install config only — no compilation)
[ -n "${RETROPIE_REPO_SHIP}" ]   || RETROPIE_REPO_SHIP="https://github.com/Yumi-Lab/RetroPie-Setup.git"
[ -n "${RETROPIE_REPO_BRANCH}" ] || RETROPIE_REPO_BRANCH="yumi-armhf"

# Pre-compiled packages from RetroMi-packages (armhf, Debian Bookworm)
[ -n "${RETROPIE_PACKAGES_URL}" ] || RETROPIE_PACKAGES_URL="https://github.com/Yumi-Lab/RetroMi-packages/releases/latest/download"
[ -n "${RETROPIE_PACKAGE_GROUPS}" ] || RETROPIE_PACKAGE_GROUPS="retroarch arcade arcade-compat nintendo n64 sega sony psp misc openbor scummvm dosbox portables computers amiga japan-computers heavy emulationstation moonlight skyscraper"

# Runtime dependencies only (no build tools — packages are pre-compiled)
[ -n "${RETROPIE_DEPS}" ]        || RETROPIE_DEPS="wget ca-certificates dialog xmlstarlet git wireless-tools wpasupplicant network-manager libfreeimage3 libsdl2-2.0-0 libsdl2-mixer-2.0-0 libsdl2-ttf-2.0-0 libvlc5 libxinerama1 libqt6core6 libqt6gui6 libqt6network6 libqt6sql6 libqt6xml6 libqt6sql6-sqlite libavahi-client3 avahi-daemon avahi-utils libnss-mdns moonlight-qt"
