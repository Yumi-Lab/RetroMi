#!/usr/bin/env bash
#### RetroPie — Install pre-compiled packages from RetroMi-packages
# shellcheck enable=require-variable-braces

set -Ee
export LC_ALL=C
export DEBIAN_FRONTEND=noninteractive

# shellcheck disable=SC1091
source /common.sh
install_cleanup_trap

echo_green "Installing RetroPie (pre-compiled packages)..."

# Deploy RetroMi overlay files (openbor-pad-config, openbor.sh)
unpack /filesystem/root /

# Runtime dependencies (no compiler needed)
apt-get update
# shellcheck disable=SC2086
check_install_pkgs ${RETROPIE_DEPS}

# Download and extract each pre-compiled package group
mkdir -p /opt/retropie

# shellcheck disable=SC2086
for group in ${RETROPIE_PACKAGE_GROUPS}; do
    echo_green "Downloading ${group} packages..."
    if wget --tries=3 --waitretry=15 --timeout=60 --retry-on-http-error=502,503,504 --show-progress \
        -O "/tmp/packages-${group}-armhf.tar.gz" \
        "${RETROPIE_PACKAGES_URL}/packages-${group}-armhf.tar.gz"; then
        echo_green "Extracting ${group} packages..."
        tar -xzf "/tmp/packages-${group}-armhf.tar.gz" -C /
        rm -f "/tmp/packages-${group}-armhf.tar.gz"
    else
        echo_green "WARNING: packages-${group}-armhf.tar.gz not available in current release — skipping"
        rm -f "/tmp/packages-${group}-armhf.tar.gz"
    fi
done

# Create all ROM directories so the structure is ready for USB auto-mount
ROM_DIR="/home/${BASE_USER}/RetroPie/roms"
mkdir -p "${ROM_DIR}"
for sys in \
    nes snes megadrive mastersystem gamegear genesis sega32x segacd sg-1000 \
    gb gbc gba nds n64 \
    psx psp \
    atari2600 atari5200 atari7800 atarilynx atarist \
    pcengine ngp ngpc wonderswan wonderswancolor \
    mame-libretro fba arcade neogeo \
    scummvm dosbox \
    c64 msx zxspectrum amstradcpc amiga \
    dreamcast saturn 3do jaguar \
    vectrex coleco intellivision \
    virtualboy pokemini supervision megaduck uzebox arduboy \
    pc88 pc98 x68000 x1 \
    ports; do
    mkdir -p "${ROM_DIR}/${sys}"
done
chown -R "${BASE_USER}:${BASE_USER}" "${ROM_DIR}"

# Download game data from Yumi-Lab/RetroMi-games
# GitHub releases use 302 redirects — curl handles them better than wget in QEMU chroot
ROM_PORTS="/home/${BASE_USER}/RetroPie/roms/ports"
mkdir -p "${ROM_PORTS}"
GAMES_URL="https://github.com/Yumi-Lab/RetroMi-games/releases/latest/download/ports-data.tar.gz"
echo_green "Downloading ports game data (Doom, Quake, Cave Story, XRick, Dinothawr, Mr.Boom, DOSBox)..."
curl -fSL --retry 5 --retry-delay 10 --connect-timeout 30 \
    -o /tmp/ports-data.tar.gz "${GAMES_URL}" || true
if [ -f /tmp/ports-data.tar.gz ] && [ "$(stat -c%s /tmp/ports-data.tar.gz 2>/dev/null)" -gt 1000 ]; then
    tar xzf /tmp/ports-data.tar.gz -C "${ROM_PORTS}/"
    rm -f /tmp/ports-data.tar.gz
    chown -R "${BASE_USER}:${BASE_USER}" "${ROM_PORTS}"
    echo_green "Ports game data installed."
else
    echo_green "WARNING: ports-data.tar.gz download failed or empty — skipping"
    rm -f /tmp/ports-data.tar.gz
fi

# Homebrew ROMs — 288 legally free ROMs across 11 systems
HOMEBREW_URL="https://github.com/Yumi-Lab/RetroMi-games/releases/latest/download/homebrew-roms.zip"
echo_green "Downloading homebrew ROMs (NES, SNES, Megadrive, SMS, GBA, Atari, ZX Spectrum, Arcade...)..."
curl -fSL --retry 5 --retry-delay 10 --connect-timeout 30 \
    -o /tmp/homebrew-roms.zip "${HOMEBREW_URL}" || true
if [ -f /tmp/homebrew-roms.zip ] && [ "$(stat -c%s /tmp/homebrew-roms.zip 2>/dev/null)" -gt 10000 ]; then
    apt-get install -y unzip -qq
    unzip -q -o /tmp/homebrew-roms.zip -d /tmp/homebrew-roms
    for dir in /tmp/homebrew-roms/*/; do
        system=$(basename "${dir}")
        target="/home/${BASE_USER}/RetroPie/roms/${system}"
        [ -d "${target}" ] && cp -r "${dir}"* "${target}/" 2>/dev/null || true
    done
    rm -rf /tmp/homebrew-roms /tmp/homebrew-roms.zip
    chown -R "${BASE_USER}:${BASE_USER}" "/home/${BASE_USER}/RetroPie/roms"
    echo_green "Homebrew ROMs installed."
else
    echo_green "WARNING: homebrew-roms.zip download failed — skipping"
    rm -f /tmp/homebrew-roms.zip
fi

# Deploy OpenBOR launcher + gamepad config script
unpack /filesystem/root /
chmod +x /usr/local/bin/openbor-pad-config
chmod +x /opt/retropie/ports/openbor/openbor.sh 2>/dev/null || true

# Clone RetroPie-Setup fork for post-install configuration only (no compilation)
pushd "/home/${BASE_USER}" &>/dev/null || exit 1
gitclone RETROPIE_REPO Retropie-Setup
popd &>/dev/null || exit 1

# Force platform detection for QEMU builds (prevents -march=native on x86 host)
# Without this, RetroPie-Setup falls back to platform_native() in QEMU chroot,
# which compiles with host CPU instructions → "Illegal instruction" on real H3
# armv7-mali: platform_armv7-mali() exists → cpu_armv7() → -march=armv7-a (proper ARMv7)
export __platform="armv7-mali"

# Force RetroPie-Setup to use the target user (not the CI runner or root user)
# Without this, paths in es_systems.cfg and emulators.cfg point to /home/runner
# or /root instead of /home/pi
export __user="${BASE_USER}"

# Run post-install steps: Bluetooth, USB ROM service, autostart
# EmulationStation is now pre-compiled in RetroMi-packages (no more inline build)
pushd "/home/${BASE_USER}/Retropie-Setup" &>/dev/null || exit 1
bash retropie_packages.sh runcommand
bash retropie_packages.sh bluetooth depends
# usbromservice calls dpkg-buildpackage to compile usbmount — no GPG key in CI.
# Wrap dpkg-buildpackage to always skip signing.
cat > /usr/local/bin/dpkg-buildpackage << 'DPKG_WRAPPER'
#!/bin/bash
exec /usr/bin/dpkg-buildpackage --no-sign "$@"
DPKG_WRAPPER
chmod +x /usr/local/bin/dpkg-buildpackage
# shellcheck disable=SC2015
for i in 1 2 3; do bash retropie_packages.sh usbromservice && break || { [ "${i}" -lt 3 ] && echo "usbromservice attempt ${i} failed, retrying..." && sleep 10; }; done
rm -f /usr/local/bin/dpkg-buildpackage

# RetroPie supplementary packages — menu items and utilities
echo_green "Installing RetroPie supplementary packages..."

# Core utilities (always installed — lightweight scripts)
bash retropie_packages.sh joy2key || true          # gamepad-to-keyboard in terminal menus
bash retropie_packages.sh wifi || true             # WiFi configuration menu
false && bash retropie_packages.sh audiosettings || true    # audio output configuration — !all rpi (menu RPi-specific)
bash retropie_packages.sh configedit || true       # RetroArch/ES config editor
bash retropie_packages.sh esthemes || true         # theme downloader from ES menu
false && bash retropie_packages.sh splashscreen || true     # boot splash screen configuration — !all rpi (RetroMi uses plymouth module)
bash retropie_packages.sh resetromdirs || true     # reset/create ROM directory structure

# Extended packages (skipped in LIGHT mode — these compile from source and add ~3GB)
if [ "${RETROMI_LIGHT}" != "yes" ]; then
    echo_green "Full build — installing extended packages..."

    # Game scrapers (metadata + artwork)
    bash retropie_packages.sh scraper || true          # sselphs scraper

    # Multiplayer & streaming
    bash retropie_packages.sh retronetplay || true     # LAN/online multiplayer

    # Controller drivers
    false && bash retropie_packages.sh gamecondriver || true    # GPIO wired NES/SNES/N64/PSX controllers — !all rpi (Broadcom GPIO only)
    false && bash retropie_packages.sh mkarcadejoystick || true # GPIO arcade joystick driver — !all rpi (Broadcom GPIO only)
    false && bash retropie_packages.sh snesdev || true          # GPIO SNES controller driver — !all rpi (Broadcom GPIO only)
    bash retropie_packages.sh steamcontroller || true  # Steam Controller support
    false && bash retropie_packages.sh xpad || true             # Xbox controller kernel driver — !mali (kernel module already in Armbian)
    bash retropie_packages.sh xpadneo || true          # Xbox One S/X wireless driver
    bash retropie_packages.sh sixaxis || true          # PS3/PS4 Sixaxis pairing via standard BlueZ
    false && bash retropie_packages.sh controlblock || true     # GPIO power/reset button (arcade builds) — !all rpi (Broadcom GPIO only)
    false && bash retropie_packages.sh powerblock || true       # GPIO power management — !all rpi (Broadcom GPIO only)

    # Virtual/mobile controllers
    bash retropie_packages.sh mobilegamepad || true    # phone as gamepad via WiFi
    bash retropie_packages.sh virtualgamepad || true   # web-based virtual gamepad
else
    echo_green "LIGHT build — skipping extended packages"
fi

echo_green "RetroPie supplementary packages... [DONE]"

# Configure EmulationStation FIRST — it generates 3000-line per-system retroarch.cfg
# files. The lr-* configure steps below will overwrite them with small #include configs.
echo_green "Configuring EmulationStation binary..."
bash retropie_packages.sh emulationstation configure || true

# Configure the RetroPie settings menu (visible as a system in ES)
bash retropie_packages.sh retropiemenu configure || true

# Register all pre-compiled libretro cores in EmulationStation
# Each 'configure' step calls addSystem → populates es_systems.cfg + emulators.cfg
# MUST run AFTER emulationstation configure to restore #include per-system configs
echo_green "Registering installed emulators in EmulationStation..."
for core_dir in /opt/retropie/libretrocores/lr-*/; do
    [ -d "${core_dir}" ] || continue
    core_name=$(basename "${core_dir}")
    echo_green "  → ${core_name}"
    bash retropie_packages.sh "${core_name}" configure || true
done
echo_green "Registering installed emulators... [DONE]"

# Set default emulators for arcade systems (after configure so definitions exist)
for system in arcade mame-libretro fba neogeo; do
    cfg="/opt/retropie/configs/${system}/emulators.cfg"
    if [ -f "${cfg}" ]; then
        sed -i '/^default/d' "${cfg}"
        echo 'default = "lr-fbneo"' >> "${cfg}"
    fi
done

# Register ports (non-libretro standalone engines)
# shellcheck disable=SC2043
for port in openbor; do
    if [ -d "/opt/retropie/ports/${port}" ] || [ -d "/opt/retropie/emulators/${port}" ]; then
        echo_green "  → ${port} (port)"
        bash retropie_packages.sh "${port}" configure || true
    fi
done

# Register standalone ports (not libretro cores — separate configure step)
if [ -f "/opt/retropie/ports/openbor/OpenBOR" ]; then
    echo_green "Registering OpenBOR port..."
    # Backup RetroMi custom launcher before configure overwrites it
    cp /opt/retropie/ports/openbor/openbor.sh /tmp/retromi-openbor.sh 2>/dev/null || true
    bash retropie_packages.sh openbor configure || true
    # Restore RetroMi version (calls openbor-pad-config before launch)
    if [ -f /tmp/retromi-openbor.sh ]; then
        cp /tmp/retromi-openbor.sh /opt/retropie/ports/openbor/openbor.sh
        chmod +x /opt/retropie/ports/openbor/openbor.sh
        rm -f /tmp/retromi-openbor.sh
        echo_green "OpenBOR gamepad auto-config launcher restored"
    fi
fi

# Safety net: fix any wrong user paths in es_systems.cfg and emulators.cfg
# (CI runner user, root, or literal ~user that wasn't expanded)
ES_CFG="/etc/emulationstation/es_systems.cfg"
if [ -f "${ES_CFG}" ]; then
    sed -i "s|/root/RetroPie|/home/${BASE_USER}/RetroPie|g;
            s|/root/Retropie-Setup|/home/${BASE_USER}/Retropie-Setup|g;
            s|/home/runner/RetroPie|/home/${BASE_USER}/RetroPie|g;
            s|/home/runner/Retropie-Setup|/home/${BASE_USER}/Retropie-Setup|g;
            s|~runner/RetroPie|/home/${BASE_USER}/RetroPie|g;
            s|~runner/Retropie-Setup|/home/${BASE_USER}/Retropie-Setup|g" "${ES_CFG}"
    echo_green "Fixed es_systems.cfg paths → /home/${BASE_USER}/"
fi
# Also fix emulators.cfg paths for runcommand
find /opt/retropie/configs -name "emulators.cfg" -exec \
    sed -i "s|/home/runner/|/home/${BASE_USER}/|g;
            s|~runner/|/home/${BASE_USER}/|g;
            s|/root/|/home/${BASE_USER}/|g" {} \;

# Ensure retropiemenu .rp files exist
# RetroPie-Setup skips wifi.rp on non-Raspbian and audiosettings/splashscreen on non-RPi
# We force-create them since our Armbian SmartPi supports all these features
RPMENU_DIR="/home/${BASE_USER}/RetroPie/retropiemenu"
mkdir -p "${RPMENU_DIR}"

# WiFi — skipped by retropiemenu because __os_id != "Raspbian"
if [ ! -f "${RPMENU_DIR}/wifi.rp" ]; then
    touch "${RPMENU_DIR}/wifi.rp"
    echo_green "Created wifi.rp (forced for Armbian)"
fi

# Audio settings — skipped by retropiemenu because isPlatform "rpi" = false
if [ ! -f "${RPMENU_DIR}/audiosettings.rp" ]; then
    touch "${RPMENU_DIR}/audiosettings.rp"
    echo_green "Created audiosettings.rp (forced for Armbian)"
fi

# Splash screen — same reason
if [ ! -f "${RPMENU_DIR}/splashscreen.rp" ]; then
    touch "${RPMENU_DIR}/splashscreen.rp"
    echo_green "Created splashscreen.rp (forced for Armbian)"
fi

# RetroPie Setup fallback
if [ ! -f "${RPMENU_DIR}/rpsetup.rp" ]; then
    touch "${RPMENU_DIR}/rpsetup.rp"
    echo_green "Created rpsetup.rp (fallback)"
fi

# If retropiemenu is missing from es_systems.cfg, add it as fallback
if [ -f "${ES_CFG}" ] && ! grep -q "retropiemenu" "${ES_CFG}"; then
    echo_green "Adding retropiemenu entry to es_systems.cfg..."
    sed -i "/<\/systemList>/i\\
  <system>\\
    <name>retropie</name>\\
    <fullname>RetroPie</fullname>\\
    <path>/home/${BASE_USER}/RetroPie/retropiemenu</path>\\
    <extension>.rp .sh</extension>\\
    <command>sudo /home/${BASE_USER}/Retropie-Setup/retropie_packages.sh retropiemenu launch %ROM% \&lt;/dev/tty \&gt;/dev/tty</command>\\
    <platform/>\\
    <theme>retropie</theme>\\
  </system>" "${ES_CFG}"
fi

# Configure EmulationStation auto-start
# retropie_packages.sh autostart is a config/gui module — inline the logic directly
AUTOSTART_SCRIPT="${configdir:-/opt/retropie/configs}/all/autostart.sh"
mkdir -p "$(dirname "${AUTOSTART_SCRIPT}")"

# Profile script: launch autostart.sh on tty1 login
cat > /etc/profile.d/10-retropie.sh << RETROPIE_PROFILE
# launch our autostart apps (if we are on the correct tty and not in X)
if [ "\$(tty)" = "/dev/tty1" ] && [ -z "\${DISPLAY}" ] && [ "\${USER}" = "${BASE_USER}" ]; then
    bash "${AUTOSTART_SCRIPT}"
fi
RETROPIE_PROFILE

# Remove legacy ES profile script
rm -f /etc/profile.d/10-emulationstation.sh

# Set EmulationStation as default autostart
touch "${AUTOSTART_SCRIPT}"
sed -i '/#auto/d' "${AUTOSTART_SCRIPT}"
echo "emulationstation #auto" >> "${AUTOSTART_SCRIPT}"
chown "${BASE_USER}:${BASE_USER}" "${AUTOSTART_SCRIPT}"

# Autologin on tty1 via systemd getty override
mkdir -p /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/autologin.conf << GETTY_CONF
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin ${BASE_USER} --noclear %I \$TERM
GETTY_CONF

echo_green "EmulationStation auto-start configured."

popd &>/dev/null || exit 1

# Prevent EmulationStation from launching during firstboot wizard
# autostart.sh is sourced on login — skip ES if /.firstboot marker exists
AUTOSTART="/opt/retropie/configs/all/autostart.sh"
if [ -f "${AUTOSTART}" ]; then
    sed -i '/emulationstation/i\[ -f /.firstboot ] && exit 0' "${AUTOSTART}"
    echo_green "Added firstboot guard to autostart.sh"
fi

# Force epicnoir on first ES launch only (ES regenerates es_settings.cfg with Carbon default)
# Uses a marker file so the user can change theme freely after first boot
# ES reads from BOTH locations — fix both
ES_HOME="/home/${BASE_USER}/.emulationstation/es_settings.cfg"
ES_ALL="/opt/retropie/configs/all/emulationstation/es_settings.cfg"
THEME_MARKER="/home/${BASE_USER}/.emulationstation/.epicnoir_set"
if [ -f "${AUTOSTART}" ]; then
    # shellcheck disable=SC2016
    sed -i '/emulationstation/i\if [ ! -f '"${THEME_MARKER}"' ]; then for _cfg in '"${ES_HOME}"' '"${ES_ALL}"'; do sed -i '\''s|<string name="ThemeSet" value="[^"]*"|<string name="ThemeSet" value="epicnoir"|'\'' "$_cfg" 2>/dev/null; done; touch '"${THEME_MARKER}"'; fi' "${AUTOSTART}"
    echo_green "Added one-time epicnoir theme enforcer to autostart.sh"
fi

# Per-system retroarch.cfg uses #include to inherit from the global config.
# RetroPie's stock global config auto-detects video/audio drivers — do NOT override it.
# Gamepad: autodetect=true — RetroArch uses 1089 built-in autoconfig presets (udev/)
# to match any USB/BT gamepad by device name. Custom overrides for the Twin USB Gamepad
# (0810:0001) live in retroarch-joypads/ (deployed by the retroarch module).
# No explicit per-player bindings in the global config — autoconfig handles everything.
GLOBAL_RA="/opt/retropie/configs/all/retroarch.cfg"
if [ -f "${GLOBAL_RA}" ]; then
    # input_enable_hotkey = "nul" disables all gamepad hotkeys — remove it
    sed -i '/^input_enable_hotkey = "nul"/d' "${GLOBAL_RA}"
    # When a game exits via its own menu, quit RetroArch and return to ES
    grep -q "quit_on_close_content" "${GLOBAL_RA}" || \
        echo 'quit_on_close_content = "2"' >> "${GLOBAL_RA}"
    # Ensure autodetect is enabled (RetroArch matches gamepads via 1089 built-in presets)
    sed -i 's/^input_autodetect_enable = "false"/input_autodetect_enable = "true"/' "${GLOBAL_RA}"
    # Hotkey combo: SELECT (btn8) + START (btn9) = quit RetroArch
    grep -q "input_enable_hotkey_btn" "${GLOBAL_RA}" || \
        echo 'input_enable_hotkey_btn = "8"' >> "${GLOBAL_RA}"
    grep -q "input_exit_emulator_btn" "${GLOBAL_RA}" || \
        echo 'input_exit_emulator_btn = "9"' >> "${GLOBAL_RA}"
    # input_menu_toggle_btn is set per-gamepad in autoconfig profiles (retroarch-joypads/)
    # NOT in global config — a global value triggers without hotkey combo
    # menu_swap_ok_cancel_buttons is set in the firstboot wizard (/usr/local/bin/firstboot)
    # because boot resets retroarch.cfg to defaults — do NOT set it here
    # No explicit player bindings — autoconfig presets handle all gamepads
fi

# Devmode toggle script — switch runcommand menu ON/OFF from RetroPie menu
RETROPIEMENU="/home/${BASE_USER}/RetroPie/retropiemenu"
cat > "${RETROPIEMENU}/zz-devmode.sh" << 'DEVMODE'
#!/bin/bash
CFG=/opt/retropie/configs/all/runcommand.cfg
if grep -q 'disable_menu = "1"' "$CFG" 2>/dev/null; then
    CURRENT="OFF"
else
    CURRENT="ON"
fi
choice=$(dialog --backtitle "RetroMi — Dev Mode (current: $CURRENT)" \
    --title "Dev Mode" \
    --menu "\nON  = Runcommand menu visible before games.\n      Press a button within 2s to configure\n      core, video mode or BIOS settings.\n\nOFF = Black screen between ES and games.\n      Clean transition, no menu.\n" 18 58 2 \
    "OFF" "Black screen (production)" \
    "ON"  "Show runcommand menu" \
    3>&1 1>&2 2>&3)
case "$choice" in
    ON)
        sed -i 's/disable_menu = "1"/disable_menu = "0"/' "$CFG"
        dialog --backtitle "RetroMi" --msgbox "\n  Dev Mode : ON\n\n  Runcommand menu is now visible." 9 45
        ;;
    OFF)
        sed -i 's/disable_menu = "0"/disable_menu = "1"/' "$CFG"
        dialog --backtitle "RetroMi" --msgbox "\n  Dev Mode : OFF\n\n  Black screen between ES and games." 9 45
        ;;
esac
DEVMODE
chmod +x "${RETROPIEMENU}/zz-devmode.sh"

# gamelist.xml — custom display name for devmode in ES menu
cat > "${RETROPIEMENU}/gamelist.xml" << 'GAMELIST'
<?xml version="1.0"?>
<gameList>
  <game>
    <path>./zz-devmode.sh</path>
    <name>Devmode : ON/OFF</name>
    <desc>Toggle runcommand menu before games. ON = debug/config, OFF = clean black screen.</desc>
  </game>
</gameList>
GAMELIST
echo_green "Devmode toggle script installed"

# Fix ownership
chown -R "${BASE_USER}:${BASE_USER}" "/home/${BASE_USER}/Retropie-Setup"
chown -R "${BASE_USER}:${BASE_USER}" "/opt/retropie/configs" 2>/dev/null || true
chown -R "${BASE_USER}:${BASE_USER}" "/home/${BASE_USER}/RetroPie" 2>/dev/null || true

echo_green "Installing RetroPie (pre-compiled packages)... [DONE]"
