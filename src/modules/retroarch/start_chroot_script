#!/usr/bin/env bash
#### RetroMi — RetroArch config deployment
#### Deploys pre-baked retroarch.cfg (H3/Mali-400 optimized) + SDL_GameControllerDB.
#### RetroArch itself is installed by the retropie module via RetroMi-packages.

# shellcheck enable=require-variable-braces
set -Ee

# Source CustomPIOS common.sh
# shellcheck disable=SC1091
source /common.sh
install_cleanup_trap

echo_green "Deploying RetroArch config (H3/Mali-400 optimized)..."

# Create required directories (remove file if retropie installed it as a file instead of a directory)
rm -f /opt/retropie/configs/all/retroarch-joypads 2>/dev/null || true
mkdir -p /opt/retropie/configs/all/retroarch-joypads
mkdir -p /home/pi/RetroPie/saves
mkdir -p /home/pi/RetroPie/savestates
mkdir -p /home/pi/RetroPie/screenshots

# Deploy retroarch.cfg + joypad configs from filesystem
unpack /filesystem/opt/retropie/configs/all /opt/retropie/configs/all

# Fix conflicting built-in autoconfig presets for USB Gamepad (0810:0001)
# RetroArch ships profiles with hat-based D-pad (ABS_HAT0X/Y) but our gamepads
# send D-pad via ABS_X/Y axes. The built-in files match by vendor_id=2064 and
# override our axis-based profiles. Remove them and copy ours instead.
RA_BUILTIN_AUTOCONFIG="/opt/retropie/emulators/retroarch/autoconfig/udev"
if [ -d "${RA_BUILTIN_AUTOCONFIG}" ]; then
    echo_green "Fixing built-in autoconfig presets (hat→axis D-pad)..."
    # Remove conflicting built-in profiles (hat-based D-pad, wrong for our gamepads)
    rm -f "${RA_BUILTIN_AUTOCONFIG}/USB_Gamepad_.cfg"
    rm -f "${RA_BUILTIN_AUTOCONFIG}/USB_gamepad.cfg"
    rm -f "${RA_BUILTIN_AUTOCONFIG}/Twin_USB_Joystick.cfg"
    # Copy our axis-based profiles into the built-in dir as fallback
    # (joypad_autoconfig_dir is checked first, built-in dir is the safety net)
    cp /opt/retropie/configs/all/retroarch-joypads/*.cfg "${RA_BUILTIN_AUTOCONFIG}/"
    echo_green "Built-in autoconfig presets fixed."
fi

# Ensure joypad_autoconfig_dir points to our profiles (takes priority over built-in)
GLOBAL_RA="/opt/retropie/configs/all/retroarch.cfg"
if [ -f "${GLOBAL_RA}" ]; then
    if grep -q "^joypad_autoconfig_dir" "${GLOBAL_RA}"; then
        sed -i 's|^joypad_autoconfig_dir = .*|joypad_autoconfig_dir = "/opt/retropie/configs/all/retroarch-joypads"|' "${GLOBAL_RA}"
    else
        echo 'joypad_autoconfig_dir = "/opt/retropie/configs/all/retroarch-joypads"' >> "${GLOBAL_RA}"
    fi
    echo_green "joypad_autoconfig_dir set to retroarch-joypads/"
fi

# SDL_GameControllerDB — plug & play pour 4000+ manettes
# SHA pinned — updated automatically by update-deps.yml workflow
SDLDB_COMMIT="e0beee4ed92cf4360ff960c1feff17ed895b81bc"
echo_green "Downloading SDL_GameControllerDB (${SDLDB_COMMIT:0:7})..."
curl -sSL \
  "https://raw.githubusercontent.com/gabomdq/SDL_GameControllerDB/${SDLDB_COMMIT}/gamecontrollerdb.txt" \
  -o /opt/retropie/configs/all/gamecontrollerdb.txt

# Fix ownership
chown -R pi:pi /home/pi/RetroPie
chown -R pi:pi /opt/retropie/configs/all

echo_green "RetroArch config deployed. (DONE)"