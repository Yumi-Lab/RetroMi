#!/usr/bin/env bash
#### RetroMi — RetroArch config deployment
#### Deploys retroarch.cfg (H3/Mali-400 optimized) + gamepad plug & play system.
#### RetroArch itself is installed by the retropie module via RetroMi-packages.

# shellcheck enable=require-variable-braces
set -Ee

# Source CustomPIOS common.sh
# shellcheck disable=SC1091
source /common.sh
install_cleanup_trap

echo_green "Deploying RetroArch config (H3/Mali-400 optimized)..."

# Create required directories
rm -f /opt/retropie/configs/all/retroarch-joypads 2>/dev/null || true
mkdir -p /opt/retropie/configs/all/retroarch-joypads
mkdir -p /home/pi/RetroPie/saves
mkdir -p /home/pi/RetroPie/savestates
mkdir -p /home/pi/RetroPie/screenshots

# Deploy joypad configs + runcommand hook + retromi-pad-config from filesystem
unpack /filesystem/opt/retropie/configs/all /opt/retropie/configs/all
unpack /filesystem/usr/local/bin /usr/local/bin
chmod +x /usr/local/bin/retromi-pad-config
chmod +x /opt/retropie/configs/all/runcommand-onstart.sh

# ============================================================
# Gamepad Plug & Play — configure RetroArch for autodetect
# ============================================================
# Strategy: enable RetroArch autodetect + retromi-pad-config generates
# autoconfig profiles with EXACT kernel device names at boot/hotplug.
# This is the same approach as Batocera's configgen but as a bash script.
GLOBAL_RA="/opt/retropie/configs/all/retroarch.cfg"

if [ -f "${GLOBAL_RA}" ]; then
    echo_green "Configuring RetroArch for gamepad plug & play..."

    # Disable autodetect (Batocera approach: retromi-pad-config writes
    # input_player* bindings directly from es_input.cfg at each game launch)
    sed -i 's/^input_autodetect_enable = "true"/input_autodetect_enable = "false"/' "${GLOBAL_RA}"
    if ! grep -q "^input_autodetect_enable" "${GLOBAL_RA}"; then
        echo 'input_autodetect_enable = "false"' >> "${GLOBAL_RA}"
    fi

    # Remove hardcoded player bindings — autodetect + pad-config handle this
    sed -i '/^input_player[0-9]*_joypad_index/d' "${GLOBAL_RA}"
    sed -i '/^input_player[0-9]*_analog_dpad_mode/d' "${GLOBAL_RA}"
    sed -i '/^input_player[0-9]*_.*_btn/d' "${GLOBAL_RA}"
    sed -i '/^input_player[0-9]*_.*_axis/d' "${GLOBAL_RA}"

    # Remove global input_menu_toggle_btn (must be per-profile only,
    # otherwise it triggers standalone without hotkey combo)
    sed -i '/^input_menu_toggle_btn/d' "${GLOBAL_RA}"

    # Ensure hotkey + exit are set globally (works with per-profile overrides)
    grep -q "^input_enable_hotkey_btn" "${GLOBAL_RA}" || echo 'input_enable_hotkey_btn = "8"' >> "${GLOBAL_RA}"
    grep -q "^input_exit_emulator_btn" "${GLOBAL_RA}" || echo 'input_exit_emulator_btn = "9"' >> "${GLOBAL_RA}"

    # Disable GLSL shaders — stock shader fails to compile on Lima/Mesa GLES2
    # (GL_OES_standard_derivatives unsupported + syntax error → RetroArch exits immediately)
    sed -i 's/^video_shader_enable = "true"/video_shader_enable = "false"/' "${GLOBAL_RA}"
    grep -q '^video_shader_enable' "${GLOBAL_RA}" || echo 'video_shader_enable = "false"' >> "${GLOBAL_RA}"

    # Use Ozone menu driver (modern UI, better than RGUI)
    sed -i '/^menu_driver/d' "${GLOBAL_RA}"
    echo 'menu_driver = "ozone"' >> "${GLOBAL_RA}"

    # Core info path — required for netplay to detect core capabilities
    sed -i '/^libretro_info_path/d' "${GLOBAL_RA}"
    echo 'libretro_info_path = "/opt/retropie/configs/all/retroarch/cores"' >> "${GLOBAL_RA}"

    # Per-system input remapping
    sed -i '/^auto_remaps_enable/d' "${GLOBAL_RA}"
    sed -i '/^remap_save_on_exit/d' "${GLOBAL_RA}"
    {
        echo 'auto_remaps_enable = "true"'
        echo 'remap_save_on_exit = "true"'
    } >> "${GLOBAL_RA}"

    # Netplay — peer-to-peer ready out-of-the-box
    sed -i '/^netplay_nickname/d' "${GLOBAL_RA}"
    sed -i '/^netplay_ip_port/d' "${GLOBAL_RA}"
    sed -i '/^netplay_use_mitm_server/d' "${GLOBAL_RA}"
    sed -i '/^netplay_check_frames/d' "${GLOBAL_RA}"
    sed -i '/^netplay_delay_frames/d' "${GLOBAL_RA}"
    sed -i '/^netplay_input_latency_frames_min/d' "${GLOBAL_RA}"
    {
        echo 'netplay_nickname = "RetroMi"'
        echo 'netplay_ip_port = "55435"'
        echo 'netplay_use_mitm_server = "false"'
        echo 'netplay_check_frames = "2"'
        echo 'netplay_delay_frames = "2"'
        echo 'netplay_input_latency_frames_min = "1"'
    } >> "${GLOBAL_RA}"

    echo_green "RetroArch gamepad plug & play + netplay configured."
fi

# Remove conflicting built-in autoconfig presets
# These match by VID+PID but have wrong D-pad mapping (hat vs axis)
# or wrong button layout. retromi-pad-config generates correct ones at runtime.
RA_BUILTIN_AUTOCONFIG="/opt/retropie/emulators/retroarch/autoconfig-presets/udev"
if [ -d "${RA_BUILTIN_AUTOCONFIG}" ]; then
    echo_green "Cleaning conflicting built-in autoconfig presets..."
    rm -f "${RA_BUILTIN_AUTOCONFIG}/USB_Gamepad_.cfg"
    rm -f "${RA_BUILTIN_AUTOCONFIG}/USB_gamepad.cfg"
    rm -f "${RA_BUILTIN_AUTOCONFIG}/Twin_USB_Joystick.cfg"
fi

# SDL_GameControllerDB — plug & play pour 4000+ manettes
# SHA pinned — updated automatically by update-deps.yml workflow
SDLDB_COMMIT="e0beee4ed92cf4360ff960c1feff17ed895b81bc"
echo_green "Downloading SDL_GameControllerDB (${SDLDB_COMMIT:0:7})..."
curl -sSL \
  "https://raw.githubusercontent.com/gabomdq/SDL_GameControllerDB/${SDLDB_COMMIT}/gamecontrollerdb.txt" \
  -o /opt/retropie/configs/all/gamecontrollerdb.txt

# SmartPad screen is physically mounted upside-down — rotate RetroArch 180°
if [ "${BASE_SBC}" = "smartpad" ]; then
    echo_green "SmartPad detected — applying 180° rotation to RetroArch..."
    sed -i '/^video_rotation/d' "${GLOBAL_RA}"
    echo 'video_rotation = "2"' >> "${GLOBAL_RA}"
    echo_green "RetroArch 180° rotation configured."
fi

# Fix ownership
chown -R pi:pi /home/pi/RetroPie
chown -R pi:pi /opt/retropie/configs/all

echo_green "RetroArch config deployed. (DONE)"