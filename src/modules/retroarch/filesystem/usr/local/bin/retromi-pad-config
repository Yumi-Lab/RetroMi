#!/bin/bash
# retromi-pad-config — Batocera-style gamepad configuration for RetroArch
#
# Reads connected joysticks, matches against es_input.cfg by VID+PID,
# writes input_player* bindings directly into retroarch.cfg.
# input_autodetect_enable = false — same as Batocera.
#
# Triggered by: boot (systemd), hotplug (udev), game launch (runcommand)

RETROARCH_CFG="/opt/retropie/configs/all/retroarch.cfg"
PROFILES_DIR="/opt/retropie/configs/all/retroarch-joypads"
ES_INPUTS=("/home/pi/.emulationstation/es_input.cfg" "/opt/retropie/configs/all/emulationstation/es_input.cfg")
LOG="/tmp/retromi-pad-config.log"
touch "$LOG" 2>/dev/null && chmod 666 "$LOG" 2>/dev/null || true

log() { echo "[$(date '+%H:%M:%S')] $*" >> "$LOG" 2>/dev/null || true; }

find_es_input() {
    for f in "${ES_INPUTS[@]}"; do
        [ -f "$f" ] && echo "$f" && return
    done
}

guid_vid() { local g="$1"; printf "%d" "0x${g:10:2}${g:8:2}" 2>/dev/null || echo "0"; }
guid_pid() { local g="$1"; printf "%d" "0x${g:18:2}${g:16:2}" 2>/dev/null || echo "0"; }

# Find best ES GUID for VID+PID — prefer axis-based D-pad over hat
find_best_es_guid() {
    local vid="$1" pid="$2" es_file="$3"
    [ -z "$es_file" ] && return 1
    local best="" fallback=""
    local guid
    while IFS= read -r guid; do
        [ -z "$guid" ] && continue
        if [ "$(guid_vid "$guid")" = "$vid" ] && [ "$(guid_pid "$guid")" = "$pid" ]; then
            local dpad
            dpad=$(xmlstarlet sel -t -m "//inputConfig[@deviceGUID='$guid']/input[@name='up']" -v "@type" "$es_file" 2>/dev/null | head -1)
            if [ "$dpad" = "axis" ]; then
                best="$guid"
                break
            fi
            [ -z "$fallback" ] && fallback="$guid"
        fi
    done < <(xmlstarlet sel -t -m "//inputConfig[@type='joystick']" -v "@deviceGUID" -n "$es_file" 2>/dev/null)
    [ -n "$best" ] && echo "$best" && return 0
    [ -n "$fallback" ] && echo "$fallback" && return 0
    return 1
}

# Write input_player${N}_* bindings from ES mapping
# Handles both naming conventions:
#   Batocera-style: pageup, pagedown, l2, r2, l3, r3, joystick1up...
#   SDL-style: leftshoulder, rightshoulder, lefttrigger, righttrigger, leftanalogup...
write_player_bindings() {
    local player="$1" js_index="$2" guid="$3" es_file="$4"
    local p="input_player${player}"

    echo "${p}_joypad_index = \"${js_index}\""
    echo "${p}_analog_dpad_mode = \"1\""

    local has_hotkey=0 select_id=""

    while IFS='|' read -r iname itype iid ivalue; do
        [ -z "$iname" ] && continue
        local ra=""

        case "$iname" in
            a)        ra="${p}_a" ;;
            b)        ra="${p}_b" ;;
            x)        ra="${p}_x" ;;
            y)        ra="${p}_y" ;;
            up)       ra="${p}_up" ;;
            down)     ra="${p}_down" ;;
            left)     ra="${p}_left" ;;
            right)    ra="${p}_right" ;;
            start)    ra="${p}_start" ;;
            select)   ra="${p}_select"; select_id="$iid" ;;
            # Both naming conventions for shoulders/triggers
            pageup|leftshoulder)        ra="${p}_l" ;;
            pagedown|rightshoulder)     ra="${p}_r" ;;
            l2|lefttrigger)             ra="${p}_l2" ;;
            r2|righttrigger)            ra="${p}_r2" ;;
            l3|leftthumbstickclick)     ra="${p}_l3" ;;
            r3|rightthumbstickclick)    ra="${p}_r3" ;;
            hotkey|hotkeyenable)        has_hotkey=1 ;;
        esac

        case "$itype" in
            button)
                [ -n "$ra" ] && echo "${ra}_btn = \"${iid}\""
                if [ "$player" = "1" ]; then
                    case "$iname" in
                        hotkey|hotkeyenable)
                            echo "input_enable_hotkey_btn = \"${iid}\"" ;;
                    esac
                fi
                ;;
            axis)
                if [ -n "$ra" ]; then
                    [ "$ivalue" = "-1" ] && echo "${ra}_axis = \"-${iid}\"" || echo "${ra}_axis = \"+${iid}\""
                fi
                # Analog sticks — both naming conventions
                case "$iname" in
                    joystick1up|leftanalogup)      echo "${p}_l_y_minus_axis = \"-${iid}\""; echo "${p}_l_y_plus_axis = \"+${iid}\"" ;;
                    joystick1left|leftanalogleft)   echo "${p}_l_x_minus_axis = \"-${iid}\""; echo "${p}_l_x_plus_axis = \"+${iid}\"" ;;
                    joystick2up|rightanalogup)      echo "${p}_r_y_minus_axis = \"-${iid}\""; echo "${p}_r_y_plus_axis = \"+${iid}\"" ;;
                    joystick2left|rightanalogleft)  echo "${p}_r_x_minus_axis = \"-${iid}\""; echo "${p}_r_x_plus_axis = \"+${iid}\"" ;;
                    leftanalogdown)     echo "${p}_l_y_plus_axis = \"+${iid}\"" ;;
                    leftanalogright)    echo "${p}_l_x_plus_axis = \"+${iid}\"" ;;
                    rightanalogdown)    echo "${p}_r_y_plus_axis = \"+${iid}\"" ;;
                    rightanalogright)   echo "${p}_r_x_plus_axis = \"+${iid}\"" ;;
                esac
                ;;
            hat)
                if [ -n "$ra" ]; then
                    local hd=""
                    case "$ivalue" in 1) hd="up" ;; 2) hd="right" ;; 4) hd="down" ;; 8) hd="left" ;; esac
                    [ -n "$hd" ] && echo "${ra}_btn = \"h${iid}${hd}\""
                fi
                ;;
        esac
    done < <(xmlstarlet sel -t -m "//inputConfig[@deviceGUID='${guid}']/input" \
             -v "concat(@name,'|',@type,'|',@id,'|',@value)" -n "$es_file" 2>/dev/null)

    # Default hotkey = select if not explicitly mapped
    if [ "$player" = "1" ] && [ "$has_hotkey" -eq 0 ] && [ -n "$select_id" ]; then
        echo "input_enable_hotkey_btn = \"${select_id}\""
    fi
}

# VID:PID profile lookup — returns profile path if exists
find_vidpid_profile() {
    local vid_dec="$1" pid_dec="$2"
    local vid_hex pid_hex
    vid_hex=$(printf "%04x" "$vid_dec")
    pid_hex=$(printf "%04x" "$pid_dec")
    local f="${PROFILES_DIR}/${vid_hex}-${pid_hex}.cfg"
    [ -f "$f" ] && echo "$f"
}

# Write player bindings from a VID:PID profile file
write_player_from_profile() {
    local player="$1" js_index="$2" profile="$3"
    local p="input_player${player}"
    local hotkey_btn=""

    echo "${p}_joypad_index = \"${js_index}\""

    while IFS='=' read -r key val; do
        [[ "$key" =~ ^# ]] && continue
        key="${key%"${key##*[! ]}"}"  # trim trailing spaces
        val="${val%"${val##*[! ]}"}"  # trim trailing spaces
        [ -z "$key" ] && continue
        case "$key" in
            analog_dpad_mode) echo "${p}_analog_dpad_mode = \"${val}\"" ;;
            b_btn)     echo "${p}_b_btn = \"${val}\"" ;;
            a_btn)     echo "${p}_a_btn = \"${val}\"" ;;
            x_btn)     echo "${p}_x_btn = \"${val}\"" ;;
            y_btn)     echo "${p}_y_btn = \"${val}\"" ;;
            l_btn)     echo "${p}_l_btn = \"${val}\"" ;;
            r_btn)     echo "${p}_r_btn = \"${val}\"" ;;
            l2_btn)    echo "${p}_l2_btn = \"${val}\"" ;;
            r2_btn)    echo "${p}_r2_btn = \"${val}\"" ;;
            l3_btn)    echo "${p}_l3_btn = \"${val}\"" ;;
            r3_btn)    echo "${p}_r3_btn = \"${val}\"" ;;
            start_btn) echo "${p}_start_btn = \"${val}\"" ;;
            select_btn) echo "${p}_select_btn = \"${val}\"" ;;
            hotkey_btn) hotkey_btn="$val" ;;
            up_axis)    echo "${p}_up_axis = \"${val}\"" ;;
            down_axis)  echo "${p}_down_axis = \"${val}\"" ;;
            left_axis)  echo "${p}_left_axis = \"${val}\"" ;;
            right_axis) echo "${p}_right_axis = \"${val}\"" ;;
        esac
    done < "$profile"

    [ "$player" = "1" ] && [ -n "$hotkey_btn" ] && echo "input_enable_hotkey_btn = \"${hotkey_btn}\""
}

# Generic 10-button mapping
write_generic() {
    local player="$1" js_index="$2"
    local p="input_player${player}"
    cat << EOF
${p}_joypad_index = "${js_index}"
${p}_analog_dpad_mode = "1"
${p}_a_btn = "1"
${p}_b_btn = "2"
${p}_x_btn = "0"
${p}_y_btn = "3"
${p}_l_btn = "4"
${p}_r_btn = "5"
${p}_l2_btn = "6"
${p}_r2_btn = "7"
${p}_select_btn = "8"
${p}_start_btn = "9"
${p}_up_axis = "-1"
${p}_down_axis = "+1"
${p}_left_axis = "-0"
${p}_right_axis = "+0"
EOF
    [ "$player" = "1" ] && echo "input_enable_hotkey_btn = \"8\""
}

# Write a joy2key-compatible .cfg file in retroarch-joypads/
# joy2key_sdl.py reads these files to map gamepad inputs to keyboard in terminal menus
write_joy2key_profile() {
    local dev_name="$1" guid="$2" es_file="$3" profile="$4"
    local safe_name cfg_file
    safe_name=$(echo "$dev_name" | sed 's/[^a-zA-Z0-9_-]/_/g' | sed 's/__*/_/g' | sed 's/^_//;s/_$//')
    cfg_file="${PROFILES_DIR}/${safe_name}.cfg"

    # joy2key matches by SDL device name which is trimmed (no leading/trailing spaces)
    local trimmed_name
    trimmed_name=$(echo "$dev_name" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

    {
        echo "input_device = \"${trimmed_name}\""
        echo "input_driver = \"udev\""

        if [ -n "$profile" ]; then
            # Copy bindings from VID:PID profile
            while IFS='=' read -r key val; do
                [[ "$key" =~ ^# ]] && continue
                key="${key%"${key##*[! ]}"}"
                val="${val%"${val##*[! ]}"}"
                [ -z "$key" ] && continue
                case "$key" in
                    analog_dpad_mode) echo "input_analog_dpad_mode = \"${val}\"" ;;
                    *_btn)  echo "input_${key} = \"${val}\"" ;;
                    *_axis) echo "input_${key} = \"${val}\"" ;;
                esac
            done < "$profile"
        elif [ -n "$guid" ] && [ -n "$es_file" ]; then
            # Generate from ES input mapping
            while IFS='|' read -r iname itype iid ivalue; do
                [ -z "$iname" ] && continue
                local ra=""
                case "$iname" in
                    a) ra="a" ;; b) ra="b" ;; x) ra="x" ;; y) ra="y" ;;
                    up) ra="up" ;; down) ra="down" ;; left) ra="left" ;; right) ra="right" ;;
                    start) ra="start" ;; select) ra="select" ;;
                    pageup|leftshoulder) ra="l" ;; pagedown|rightshoulder) ra="r" ;;
                    l2|lefttrigger) ra="l2" ;; r2|righttrigger) ra="r2" ;;
                esac
                [ -z "$ra" ] && continue
                case "$itype" in
                    button) echo "input_${ra}_btn = \"${iid}\"" ;;
                    axis)
                        if [ "$ivalue" = "-1" ]; then
                            echo "input_${ra}_axis = \"-${iid}\""
                        else
                            echo "input_${ra}_axis = \"+${iid}\""
                        fi
                        ;;
                    hat)
                        local hd=""
                        case "$ivalue" in 1) hd="up" ;; 2) hd="right" ;; 4) hd="down" ;; 8) hd="left" ;; esac
                        [ -n "$hd" ] && echo "input_${ra}_btn = \"h${iid}${hd}\""
                        ;;
                esac
            done < <(xmlstarlet sel -t -m "//inputConfig[@deviceGUID='${guid}']/input" \
                     -v "concat(@name,'|',@type,'|',@id,'|',@value)" -n "$es_file" 2>/dev/null)
        else
            # Generic fallback (axis D-pad)
            echo 'input_a_btn = "1"'
            echo 'input_b_btn = "2"'
            echo 'input_x_btn = "0"'
            echo 'input_y_btn = "3"'
            echo 'input_l_btn = "4"'
            echo 'input_r_btn = "5"'
            echo 'input_select_btn = "8"'
            echo 'input_start_btn = "9"'
            echo 'input_up_axis = "-1"'
            echo 'input_down_axis = "+1"'
            echo 'input_left_axis = "-0"'
            echo 'input_right_axis = "+0"'
        fi
    } > "$cfg_file"
    log "  → joy2key profile: ${cfg_file}"
}

# Main: scan joysticks and inject player bindings
configure_all() {
    local es_file
    es_file=$(find_es_input)
    log "ES input: ${es_file:-none}"
    [ ! -f "$RETROARCH_CFG" ] && { log "ERROR: $RETROARCH_CFG not found"; return 1; }

    # Clean existing player/hotkey bindings
    sed -i '/^input_player[0-9]/d' "$RETROARCH_CFG"
    sed -i '/^input_enable_hotkey_btn/d' "$RETROARCH_CFG"
    sed -i '/^input_exit_emulator_btn/d' "$RETROARCH_CFG"
    sed -i '/^input_menu_toggle_btn/d' "$RETROARCH_CFG"

    # Clean joy2key profiles (regenerated each run)
    rm -f "${PROFILES_DIR}"/*.cfg

    # Scan joysticks and build bindings
    local bindings=""
    local player=1 name="" vid="" pid=""

    while IFS= read -r line; do
        case "$line" in
            I:*)
                vid=$(echo "$line" | grep -oP 'Vendor=\K[0-9a-f]+')
                pid=$(echo "$line" | grep -oP 'Product=\K[0-9a-f]+')
                ;;
            N:*)
                name="${line#N: Name=\"}"
                name="${name%\"}"
                ;;
            H:*)
                if echo "$line" | grep -q "js[0-9]"; then
                    local js_index vid_dec pid_dec guid
                    js_index=$(echo "$line" | grep -oP 'js\K[0-9]+')
                    vid_dec=$(printf "%d" "0x${vid}")
                    pid_dec=$(printf "%d" "0x${pid}")

                    log "Player ${player}: '${name}' js${js_index} VID:${vid_dec} PID:${pid_dec}"

                    local profile
                    profile=$(find_vidpid_profile "$vid_dec" "$pid_dec")
                    if [ -n "$profile" ]; then
                        log "  → profile $(basename "$profile")"
                        bindings+=$'\n'"$(write_player_from_profile "$player" "$js_index" "$profile")"
                        write_joy2key_profile "$name" "" "" "$profile"
                    else
                        guid=$(find_best_es_guid "$vid_dec" "$pid_dec" "$es_file" 2>/dev/null)
                        if [ -n "$guid" ]; then
                            log "  → ES GUID=${guid}"
                            bindings+=$'\n'"$(write_player_bindings "$player" "$js_index" "$guid" "$es_file")"
                            write_joy2key_profile "$name" "$guid" "$es_file" ""
                        else
                            log "  → generic"
                            bindings+=$'\n'"$(write_generic "$player" "$js_index")"
                            write_joy2key_profile "$name" "" "" ""
                        fi
                    fi
                    player=$((player+1))
                fi
                ;;
            "")
                name="" vid="" pid=""
                ;;
        esac
    done < /proc/bus/input/devices

    # Write hotkey combos + player bindings
    {
        echo "input_exit_emulator_btn = \"9\""
        echo "input_menu_toggle_btn = \"2\""
        echo "$bindings"
    } >> "$RETROARCH_CFG"

    log "Configured $((player-1)) player(s)"
}

: > "$LOG"
log "=== retromi-pad-config ==="
configure_all
log "=== done ==="
