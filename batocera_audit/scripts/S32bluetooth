#!/bin/sh
#
# Bluetooth init — auto-connect controllers
# Restores saved BT pairings from /userdata/system/bluetooth/bluetooth.tar
# Starts bluetoothd with sixaxis plugin config
# Launches batocera-bluetooth-agent (Python dbus agent)
# Handles board-specific hciattach for various SoCs

BOARD=$(cat /boot/boot/batocera.board)

case "$1" in
    start)
        batocera-bluetooth restore
        enabled="$(/usr/bin/batocera-settings-get controllers.bluetooth.enabled)"
        [ "$enabled" = "1" ] || exit 0
        rfkill unblock bluetooth

        # Board-specific hciattach (bcm150, rtk115, bcm921, piscan, sprd)

        btaddr="$(/usr/bin/batocera-settings-get bluetooth.adapter)"
        settings_version="$(/usr/bin/batocera-settings-get controllers.ps3.driver)"
        if [ "$settings_version" != "bluez" ]; then
            BLUETOOTHD_ARGS="--noplugin=sixaxis"
        else
            BLUETOOTHD_ARGS="--noplugin=sixaxispair"
        fi

        start-stop-daemon -S -q -m -p /var/run/bluetoothd.pid --exec /usr/libexec/bluetooth/bluetoothd -- $BLUETOOTHD_ARGS &

        if [ -n "${btaddr}" ]; then
            start-stop-daemon -S -q -m -p /var/run/bluetooth-agent.pid --exec /usr/bin/batocera-bluetooth-agent -- --device "${btaddr}" &
        else
            start-stop-daemon -S -q -m -p /var/run/bluetooth-agent.pid --exec /usr/bin/batocera-bluetooth-agent &
        fi
    ;;
    stop)
        start-stop-daemon -K -q -p /var/run/bluetooth-agent.pid
        start-stop-daemon -K -q -p /var/run/bluetoothd.pid
        killall hciattach >/dev/null 2>&1
        batocera-bluetooth save
    ;;
    restart|reload)
        "$0" stop
        "$0" start
    ;;
esac
